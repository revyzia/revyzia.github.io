rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function cestMoi(uid) {
      return connecte() && request.auth.uid == uid;
    }
    function fiche() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function peutPublier() {
      return connecte() && fiche().role in ['admin', 'prof'];
    }

    match /users/{uid} {

      allow read: if cestMoi(uid);

      allow create: if cestMoi(uid)
        && request.resource.data.role == 'eleve'
        && request.resource.data.xp == 0
        && request.resource.data.serie == 0
        && request.resource.data.email == request.auth.token.email;

      allow update: if cestMoi(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.serie == resource.data.serie;

      allow delete: if cestMoi(uid);

      match /progression/{chapitre} {
        allow read, write: if cestMoi(uid);
      }
    }

    // Chapitres publies : tout le monde lit, seuls admin et prof ecrivent
    match /chapitres/{id} {
      allow read: if connecte();
      allow create, update: if peutPublier()
        && request.resource.data.titre is string
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0;
      allow delete: if peutPublier();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
