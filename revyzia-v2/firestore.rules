rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function cestMoi(uid) {
      return connecte() && request.auth.uid == uid;
    }

    // Fiche utilisateur
    match /users/{uid} {

      allow read: if cestMoi(uid);

      allow create: if cestMoi(uid)
        && request.resource.data.role == 'eleve'
        && request.resource.data.xp == 0
        && request.resource.data.serie == 0
        && request.resource.data.email == request.auth.token.email;

      // role, XP et serie ne bougent jamais depuis le navigateur
      allow update: if cestMoi(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.serie == resource.data.serie;

      allow delete: if cestMoi(uid);

      // Progression, un document par chapitre, prive a son proprietaire
      match /progression/{chapitre} {
        allow read, write: if cestMoi(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
